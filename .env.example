# Neon PostgreSQL (ne jamais committer le vrai .env)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/ckcollection?sslmode=require"

# Backend
JWT_SECRET="changez-moi-64-caracteres-minimum"
JWT_EXPIRES_IN="7d"
PORT=4000
FRONTEND_URL="http://localhost:5174"
ADMIN_EMAIL="admin@c-k-collection.dz"
ADMIN_PASSWORD="Admin123!"

# Email (SMTP) — requis pour l'email de confirmation de commande
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="votre-email@gmail.com"
SMTP_PASS="mot-de-passe-application"
MAIL_FROM="C-K-Collection <votre-email@gmail.com>"

# Frontend (préfixe VITE_ exposé au navigateur — aucun secret ici)
VITE_API_URL="http://localhost:4001/api"
VITE_BRAND_NAME="C-K-Collection"
VITE_INSTAGRAM_URL="https://www.instagram.com/c_k.collection__/"
